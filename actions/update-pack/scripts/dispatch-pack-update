#!/usr/bin/env bash
set -euo pipefail

GH_TOKEN="${GH_TOKEN:?error: GH_TOKEN is required}"
SOURCE_GH_TOKEN="${SOURCE_GH_TOKEN:?error: SOURCE_GH_TOKEN is required}"
PACK="${PACK:?error: PACK is required}"
VERSION="${VERSION:?error: VERSION is required}"
CHANNEL="${CHANNEL:?error: CHANNEL is required}"
MODE="${MODE:?error: MODE is required}"
GUARD_REF="${GUARD_REF:-}"
GIT_NAME="${GIT_NAME:?error: GIT_NAME is required}"
GIT_EMAIL="${GIT_EMAIL:?error: GIT_EMAIL is required}"

[[ "${PACK}" =~ ^[A-Za-z0-9][A-Za-z0-9-]*$ ]] || {
  echo "error: invalid Pack name: ${PACK}" >&2
  exit 1
}
[[ "${VERSION}" =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$ ]] || {
  echo "error: invalid Pack version/reference tag: ${VERSION}" >&2
  exit 1
}

case "${CHANNEL}" in
  dev|rc) ;;
  *)
    echo "error: unsupported Pack channel: ${CHANNEL}" >&2
    exit 1
    ;;
esac

case "${MODE}" in
  moving)
    create_tag='false'
    ;;
  release)
    if [[ "${CHANNEL}" != 'dev' ]]; then
      echo 'error: release mode may only update the dev channel' >&2
      exit 1
    fi
    create_tag='true'
    ;;
  *)
    echo "error: unsupported Pack update mode: ${MODE}" >&2
    exit 1
    ;;
esac

if [[ -n "${GUARD_REF}" ]]; then
  latest_sha="$(GH_TOKEN="${SOURCE_GH_TOKEN}" gh api \
    "repos/${GITHUB_REPOSITORY}/git/ref/heads/${GUARD_REF}" \
    --jq '.object.sha')"
  if [[ "${latest_sha}" != "${GITHUB_SHA}" ]]; then
    echo "Skipping stale build ${GITHUB_SHA}; current ${GUARD_REF} is ${latest_sha}"
    echo 'dispatched=false' >> "${GITHUB_OUTPUT}"
    exit 0
  fi
fi

jq -cn \
  --arg ref main \
  --arg pack "${PACK}" \
  --arg docker_tag "${VERSION}" \
  --arg channel "${CHANNEL}" \
  --arg create_tag "${create_tag}" \
  --arg git_name "${GIT_NAME}" \
  --arg git_email "${GIT_EMAIL}" \
  '{
    ref: $ref,
    inputs: {
      pack: $pack,
      docker_tag: $docker_tag,
      channel: $channel,
      create_tag: $create_tag,
      git_name: $git_name,
      git_email: $git_email
    }
  }' |
  gh api repos/Qiyin-Tech/nomad-packs/actions/workflows/update-pack.yml/dispatches \
    --method POST \
    --input -

echo 'dispatched=true' >> "${GITHUB_OUTPUT}"
