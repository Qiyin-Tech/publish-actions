#!/usr/bin/env bash
set -euo pipefail

GH_TOKEN="${GH_TOKEN:?error: GH_TOKEN is required}"
SOURCE_GH_TOKEN="${SOURCE_GH_TOKEN:?error: SOURCE_GH_TOKEN is required}"
PACK="${PACK:?error: PACK is required}"
VERSION="${VERSION:?error: VERSION is required}"
BRANCH="${BRANCH:?error: BRANCH is required}"
TAG="${TAG:-false}"
GIT_NAME="${GIT_NAME:?error: GIT_NAME is required}"
GIT_EMAIL="${GIT_EMAIL:?error: GIT_EMAIL is required}"

[[ "${PACK}" =~ ^[A-Za-z0-9][A-Za-z0-9-]*$ ]] || {
  echo "error: invalid Pack name: ${PACK}" >&2
  exit 1
}
metadata_version="${VERSION}"
if jq -e 'type == "object"' <<<"${VERSION}" >/dev/null 2>&1; then
  VERSION="$(jq -ce '
    select(
      length > 0 and
      ((keys - ["artifacts", "images"]) | length == 0) and
      all(.[]; type == "object" and length > 0) and
      all(.[] | to_entries[];
        (.key | test("^[A-Za-z0-9_]+$")) and (.value | type == "string"))
    )
  ' <<<"${VERSION}")" || {
    echo "error: invalid structured Pack version" >&2
    exit 1
  }
  while IFS= read -r reference_tag; do
    [[ "${reference_tag}" =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$ ]] || {
      echo "error: invalid Pack reference tag: ${reference_tag}" >&2
      exit 1
    }
  done < <(jq -r '.[] | .[]' <<<"${VERSION}")
  primary_task="${PACK//-/_}"
  mapfile -t primary_versions < <(
    jq -r --arg task "${primary_task}" \
      '[(.images // {})[$task], (.artifacts // {})[$task]] | .[] | select(. != null)' \
      <<<"${VERSION}"
  )
  [[ "${#primary_versions[@]}" -eq 1 ]] || {
    echo "error: structured Pack version must include primary task ${primary_task} exactly once" >&2
    exit 1
  }
  metadata_version="${primary_versions[0]}"
elif [[ ! "${VERSION}" =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$ ]]; then
  echo "error: invalid Pack version/reference tag: ${VERSION}" >&2
  exit 1
fi

case "${BRANCH}" in
  dev|test|rc) ;;
  *)
    echo "error: unsupported Pack channel: ${BRANCH}" >&2
    exit 1
    ;;
esac

case "${TAG}" in
  true|false) ;;
  *)
    echo "error: tag must be true or false: ${TAG}" >&2
    exit 1
    ;;
esac

if [[ "${GITHUB_REF_TYPE}" == 'branch' ]]; then
  latest_sha="$(GH_TOKEN="${SOURCE_GH_TOKEN}" gh api \
    "repos/${GITHUB_REPOSITORY}/git/ref/heads/${GITHUB_REF_NAME}" \
    --jq '.object.sha')"
  if [[ "${latest_sha}" != "${GITHUB_SHA}" ]]; then
    echo "Skipping stale ${GITHUB_REF_NAME} build ${GITHUB_SHA}; current SHA is ${latest_sha}"
    exit 0
  fi
fi

jq -cn \
  --arg ref main \
  --arg pack "${PACK}" \
  --arg docker_tag "${VERSION}" \
  --arg metadata_version "${metadata_version}" \
  --arg branch "${BRANCH}" \
  --arg tag "${TAG}" \
  --arg git_name "${GIT_NAME}" \
  --arg git_email "${GIT_EMAIL}" \
  '{
    ref: $ref,
    inputs: {
      pack: $pack,
      docker_tag: $docker_tag,
      metadata_version: $metadata_version,
      branch: $branch,
      tag: $tag,
      git_name: $git_name,
      git_email: $git_email
    }
  }' |
  gh api repos/Qiyin-Tech/nomad-packs/actions/workflows/update-pack.yml/dispatches \
    --method POST \
    --input -
