#!/usr/bin/env bash
set -euo pipefail

CACHE_EXPORT="${CACHE_EXPORT:?error: CACHE_EXPORT is required}"
CACHE_FROM_TAG="${CACHE_FROM_TAG:-}"
RC_BRANCH="${RC_BRANCH:-}"

repository="ghcr.io/${GITHUB_REPOSITORY,,}"

if [[ "${GITHUB_EVENT_NAME}" == 'workflow_dispatch' ]]; then
  kind='manual'
  image_tag="manual-${GITHUB_SHA}"
  moving_tag=''
  tags="${repository}:${image_tag}"
elif [[ "${GITHUB_REF_TYPE}" == 'tag' ]]; then
  if [[ ! "${GITHUB_REF_NAME}" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "error: unsupported release tag: ${GITHUB_REF_NAME}" >&2
    exit 1
  fi

  kind='release'
  image_tag="${GITHUB_REF_NAME}"
  moving_tag=''
  tags="${repository}:${image_tag}"
elif [[ "${GITHUB_REF_NAME}" =~ ^release/(v[0-9]+\.[0-9]+\.[0-9]+)$ ]]; then
  if [[ "${GITHUB_REF_NAME}" != "${RC_BRANCH}" ]]; then
    echo "error: RC branch ${GITHUB_REF_NAME} is not the configured rc_branch (${RC_BRANCH:-unset})" >&2
    exit 1
  fi

  kind='rc'
  release_version="${BASH_REMATCH[1]}"
  image_tag="rc-${release_version}-${GITHUB_SHA}"
  moving_tag='rc'
  tags="${repository}:${image_tag}"
elif [[ "${GITHUB_REF_NAME}" == 'dev' ]]; then
  mapfile -t formal_tags < <(
    git tag --merged HEAD | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' || true
  )
  describe_args=(--tags --abbrev=0)
  for formal_tag in "${formal_tags[@]}"; do
    describe_args+=(--match "${formal_tag}")
  done
  if (( ${#formal_tags[@]} > 0 )); then
    base_tag="$(git describe "${describe_args[@]}" 2>/dev/null || true)"
  else
    base_tag=''
  fi
  if [[ -z "${base_tag}" ]]; then
    echo 'error: no reachable formal version tag found for this dev commit' >&2
    exit 1
  fi

  kind='dev'
  image_tag="dev-${base_tag}-${GITHUB_SHA}"
  moving_tag='dev'
  tags="${repository}:${image_tag}"
else
  echo "error: unsupported publish ref: ${GITHUB_REF}" >&2
  exit 1
fi

if [[ -n "${CACHE_FROM_TAG}" ]]; then
  cache_from="type=registry,ref=${repository}:${CACHE_FROM_TAG}"
else
  cache_from=''
fi

if [[ "${GITHUB_EVENT_NAME}" == 'workflow_dispatch' ]]; then
  cache_to=''
else
  case "${CACHE_EXPORT}" in
    registry)
      if [[ -z "${CACHE_FROM_TAG}" ]]; then
        echo 'error: cache_from_tag is required when cache_export=registry' >&2
        exit 1
      fi
      cache_to="type=registry,ref=${repository}:${CACHE_FROM_TAG},mode=max"
      ;;
    inline)
      cache_to='type=inline'
      ;;
    none)
      cache_to=''
      ;;
    *)
      echo "error: unsupported cache_export: ${CACHE_EXPORT}" >&2
      exit 1
      ;;
  esac
fi

{
  echo "image=${repository}"
  echo "image_tag=${image_tag}"
  echo "kind=${kind}"
  echo "moving_tag=${moving_tag}"
  echo "cache_from=${cache_from}"
  echo "cache_to=${cache_to}"
  echo 'tags<<EOF'
  printf '%s\n' "${tags}"
  echo 'EOF'
} >> "${GITHUB_OUTPUT}"
