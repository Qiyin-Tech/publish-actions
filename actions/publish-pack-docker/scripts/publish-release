#!/usr/bin/env bash
set -euo pipefail

PACK="${PACK:?error: PACK is required}"
GH_TOKEN="${GH_TOKEN:?error: GH_TOKEN is required}"
RELEASE_ASSET_SOURCE="${RELEASE_ASSET_SOURCE:-}"

[[ "${PACK}" =~ ^[A-Za-z0-9][A-Za-z0-9-]*$ ]] || {
  echo "error: invalid Pack name: ${PACK}" >&2
  exit 1
}

asset_args=()
if [[ -n "${RELEASE_ASSET_SOURCE}" ]]; then
  asset="${PACK}-${GITHUB_REF_NAME}.env.example"
  cp "${RELEASE_ASSET_SOURCE}" "${asset}"
  asset_args=("${asset}")
fi

if gh release view "${GITHUB_REF_NAME}" >/dev/null 2>&1; then
  gh release edit "${GITHUB_REF_NAME}" --title "${GITHUB_REF_NAME}"
  if (( ${#asset_args[@]} > 0 )); then
    gh release upload "${GITHUB_REF_NAME}" "${asset_args[@]}" --clobber
  fi
else
  gh release create "${GITHUB_REF_NAME}" \
    "${asset_args[@]}" \
    --verify-tag \
    --generate-notes \
    --title "${GITHUB_REF_NAME}"
fi
