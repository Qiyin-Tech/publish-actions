#!/usr/bin/env bash
set -euo pipefail

REF="${REF:?error: REF is required}"
GH_TOKEN="${GH_TOKEN:?error: GH_TOKEN is required}"

latest_sha="$(gh api "repos/${GITHUB_REPOSITORY}/git/ref/heads/${REF}" --jq '.object.sha')"
if [[ "${latest_sha}" == "${GITHUB_SHA}" ]]; then
  echo 'current=true' >> "${GITHUB_OUTPUT}"
  exit 0
fi

echo "Skipping stale build ${GITHUB_SHA}; current ${REF} is ${latest_sha}"
echo 'current=false' >> "${GITHUB_OUTPUT}"
